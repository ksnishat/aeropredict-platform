# FILE: infrastructure/docker/Dockerfile.airflow
FROM apache/airflow:2.7.1

USER root
# The apache/airflow:2.7.1 base image ships an apt source for
# apt.postgresql.org that no longer publishes a Release file for bullseye, so a
# plain `apt-get update` fails with exit code 100. Drop that source first.
RUN rm -f /etc/apt/sources.list.d/pgdg.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends gcc && \
    rm -rf /var/lib/apt/lists/*

USER airflow

# Install PyTorch (CPU) + Scikit-Learn + PDF Library + API LIBS
# Use --extra-index-url rather than --index-url: --index-url replaces PyPI
# entirely, so transitive dependencies such as typing-extensions and flit_core
# cannot be resolved and the build fails.
RUN pip install --no-cache-dir \
    torch \
    torchvision \
    torchaudio \
    --extra-index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir \
    pandas \
    scikit-learn \
    mlflow \
    boto3 \
    requests \
    pypdf \
    fastapi \
    uvicorn \
    pydantic \
    python-multipart

# RAG dependencies for src/rag_inference.py. The DAG imports this module at
# parse time, so a missing dependency here makes the DAG silently disappear
# from the Airflow UI rather than failing loudly.
#
# posthog is pinned below 3.0.0 because ChromaDB pulls it in for telemetry and
# posthog 3.x uses PEP 585 generics (dict[str, ...]) at runtime, which raises
# "TypeError: 'type' object is not subscriptable" on this image's Python 3.8.
RUN pip install --no-cache-dir \
    chromadb \
    langchain-chroma \
    langchain-huggingface \
    langchain-text-splitters \
    langchain-community \
    "sentence-transformers>=3.0.0,<4.0.0" \
    "posthog<3.0.0"

# ChromaDB requires sqlite3 >= 3.35.0, but the Debian bullseye base image ships
# 3.34.1 and the bullseye-security repo no longer serves a newer package. Use
# the documented pysqlite3-binary shim instead: it bundles a modern sqlite3 and
# is aliased over the stdlib module in src/rag_inference.py.
RUN pip install --no-cache-dir pysqlite3-binary

# Training exports the TorchScript model and scaler to /opt/airflow/models,
# which is a named volume. Docker initialises a fresh named volume from the
# image's directory contents and ownership, so creating it here as the airflow
# user means the volume is writable without a manual chown.
#
# The container runs as an arbitrary UID with GID 0 (the Airflow image requires
# GID 0), so this is made group-writable by root rather than owned by the
# image's default airflow user. Owning it by uid 50000 meant a container running
# as uid 1000 could not write, and publishing retrained weights failed with
# Permission denied.
USER root
RUN mkdir -p /opt/airflow/models && \
    chown -R root:root /opt/airflow/models && \
    chmod -R 775 /opt/airflow/models
USER airflow
