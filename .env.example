# ============================================================
# Environment configuration for AeroPredict.
#
# Copy to .env and edit. Every value has a working default, so the stack runs
# without this file — it exists so the knobs are discoverable.
#
#   cp .env.example .env
#
# The start scripts read these from the environment; they are not loaded from
# the file automatically, so export them or use `set -a; . ./.env; set +a`.
# ============================================================

# ---------------------------------------------------------------- security
# API key required by /predict, /drift and /admin/reload-model.
# Auth is OFF when this is unset. run_stack.sh defaults it to the demo value
# below so the stack is secure by default; change it for anything real.
API_KEY=demo-secret-key

# Maximum upload size in bytes. Enforced before the body is read.
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------- models
# Set to "true" to expose POST /admin/reload-model, which hot-swaps the served
# model. Requires API_KEY to be set, otherwise the endpoint is open.
ENABLE_MODEL_RELOAD=true
MODEL_PATH=models/lstm_best.pt
DRIFT_BASELINE_PATH=models/drift_baseline.json

# ---------------------------------------------------------------- LLM (RAG)
# Leave unset to let the RAG module resolve against the tags Ollama actually has
# pulled. Setting a tag that is not pulled causes a loud warning rather than a
# silent fallback to the template report.
# OLLAMA_MODEL=llama3.2:1b
# OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------- monitoring
# Grafana admin credentials. The demo default is admin/admin.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# MinIO root credentials. The demo default is minioadmin/minioadmin.
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# ---------------------------------------------------------------- training
# Airflow retraining parameters. Lower these for a quick smoke test.
# AEROPREDICT_EPOCHS=50
