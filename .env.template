# AeroPredict Platform - Environment Variables Template
# Copy to .env and fill in your values

# App
APP_NAME=aeropredict
APP_VERSION=1.0.0
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_LOG_FILE=logs/aeropredict.log
APP_LOG_COLORS=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_URI=http://minio:9000/mlflow
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_AWS_ACCESS_KEY_ID=minio
MLFLOW_AWS_SECRET_ACCESS_KEY=minio123
MLFLOW_EXPERIMENT_NAME=aeropredict_experiments

# Data
DATA_RAW_PATH=data/raw
DATA_PROCESSED_PATH=data/processed

# Ollama / GenAI
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=30

# Monitoring
SENTRY_DSN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Database
POSTGRES_USER=aeropredict
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aeropredict